# /etc/ppp/pppoe-server-options — opciones pppd de las sesiones PPPoE
# MSCHAPv2 SOLO: no mezclar con chap/mschap (pppd 2.5.2 usa auth MD5 si
# hay mas de un metodo y los clientes fallan).
require-mschap-v2
lcp-echo-interval 5
lcp-echo-failure 3
ms-dns 192.168.20.1
ms-dns 8.8.8.8
plugin radius.so
plugin radattr.so
